# ════════════════════════════════════════════════════════════════════════════
#  Complete Interview Mastery — environment variables
#  Copy to .env.local and fill in. NEVER commit .env.local.
# ════════════════════════════════════════════════════════════════════════════

# ── Razorpay ────────────────────────────────────────────────────────────────
# Dashboard → Settings → API Keys. Use rzp_test_* keys until you go live.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx

# SECRET. Server-only. Never prefix with NEXT_PUBLIC_.
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# SECRET. Dashboard → Settings → Webhooks. Must match the webhook's secret.
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# ── Pricing ─────────────────────────────────────────────────────────────────
# Authoritative price IN PAISE. 69900 = Rs 699 (the current special bundle price).
# The browser never sends this. Must match siteConfig.PRICE_IN_PAISE and
# pricing.BUNDLE_SPECIAL_PRICE. Changing the offer means changing all three.
PRODUCT_PRICE_PAISE=69900
PRODUCT_CURRENCY=INR

# ── Delivery ────────────────────────────────────────────────────────────────
# The Google Drive folder with the 12 PDFs. Released ONLY after verification.
# Never prefix with NEXT_PUBLIC_ — that would publish it in the JS bundle.
PRODUCT_DOWNLOAD_URL=https://drive.google.com/drive/folders/xxxxxxxxxxxxx

# ── Access tokens ───────────────────────────────────────────────────────────
# SECRET. Signs the post-purchase access token.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ACCESS_TOKEN_SECRET=replace_with_a_long_random_string

# ── Transactional email (Resend) ────────────────────────────────────────────
# SECRET. resend.com → API Keys. Sends the product delivery email and the two
# internal support notifications. Server-only; never prefix with NEXT_PUBLIC_.
# Without it the site still takes payments, but NOTHING is delivered by email.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# The From address. Its DOMAIN must be verified in Resend, or sends are
# rejected (until verification, Resend only accepts your own account address).
EMAIL_FROM="Interview Mastery <noreply@interviewmastery.shop>"

# Where checkout-started and purchase notifications go. Defaults to
# support@interviewmastery.shop when unset.
SUPPORT_EMAIL=support@interviewmastery.shop

# ── Diagnostics (optional but recommended) ──────────────────────────────────
# Enables GET /api/diagnostics, which reports WHICH env vars are set — never
# their values. Without this the route 404s, so it does not exist unless you
# opt in. Use it to confirm a deployment actually has the email variables:
#   curl https://interviewmastery.shop/api/diagnostics -H "x-diagnostics-token: ..."
DIAGNOSTICS_TOKEN=any_long_random_string
